# RusSupport AI — настройки
# Скопируйте этот файл в `.env` и заполните значения.

# --- Приложение ---
APP_NAME=RusSupport AI
APP_ENV=development
DEBUG=true
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# --- База данных ---
# SQLite (асинхронный aiosqlite).
DATABASE_URL=sqlite+aiosqlite:///./russupport.db
DATABASE_ECHO=false

# --- Демонстрационные данные ---
# Загружать ли demo-кейсы из data/mock_data.json при старте.
LOAD_MOCK_DATA_ON_STARTUP=true

# --- AI-провайдер ---
# Основной провайдер — GigaChat (российский API, не блокируется Cloudflare).
AI_ENABLED=True
AI_PROVIDER=gigachat

# Ключ авторизации из developers.sber.ru. Показывается один раз, хранить только здесь.
GIGACHAT_CREDENTIALS=MDFhMWVmYjgtZmM0Ni03NDlkLWI0Y2UtYTIzN2IwYTJlNGU0OjU5MDlkMTRjLTRiZjgtNDI5NS04ZjA1LWEzNjlkMTFlOWE4Yg==
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat:latest
GIGACHAT_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_VERIFY_SSL_CERTS=true
# Необязательно: путь к root CA Минцифры, если сертификат не добавлен в certifi.
# GIGACHAT_CA_BUNDLE_FILE=/etc/ssl/certs/russian_trusted_root_ca.crt
# true в проде. false только для локальной отладки без сертификата.
GIGACHAT_VERIFY_SSL_CERTS=true

# Запасной вариант (OpenRouter заблокирован на IP тестового сервера).
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=openrouter/free
# OPENROUTER_PROXY=
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2

# --- Telegram-бот ---
# Токен от @BotFather. Без него бот не запускается (выведет предупреждение).
TELEGRAM_BOT_TOKEN=
# Чат для одноразовой отправки сводки через telegram_summary.py.
TELEGRAM_CHAT_ID=